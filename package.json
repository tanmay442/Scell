{
  "name": "cell",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Cell \u2014 a browser-native web dev platform on V8 isolates. No kernel anywhere.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:gdg": "node scripts/e2e-gdg.mjs",
    "e2e:scribe": "node scripts/e2e-scribe.mjs",
    "e2e:agent": "node scripts/e2e-agent.mjs",
    "postinstall": "node scripts/vendor-public.mjs",
    "server:build": "rm -rf dist-server && tsc -p tsconfig.server.json && printf '{\"type\":\"commonjs\"}\\n' > dist-server/package.json",
    "server:start": "node dist-server/server/server.js",
    "server:run": "node dist-server/server/run-once.js"
  },
  "dependencies": {
    "@astryxdesign/core": "^0.7.4",
    "@astryxdesign/theme-neutral": "^0.7.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.2",
    "@heroicons/react": "^2.2.0",
    "@stylexjs/stylex": "^0.19.1",
    "@tailwindcss/browser": "^4.3.3",
    "@uiw/react-codemirror": "^4.23.7",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "esbuild-wasm": "^0.28.2",
    "fflate": "^0.8.3",
    "idb": "^8.0.1",
    "just-bash": "^3.6.0",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "semver": "^7.8.5",
    "wasm-git": "^0.0.17"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.6",
    "pyodide": "^0.27.7",
    "typescript": "^5.7.2",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "@astryxdesign/cli": "^0.7.4"
  }
}