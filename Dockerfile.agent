FROM node:22-slim
WORKDIR /srv/cell
# only the runtime deps the server bundle requires (fflate, semver);
# everything else in package.json is browser/build tooling
RUN npm install --omit=dev --no-audit --no-fund fflate@0.8.3 semver@7.8.5
# python3 + Pillow: the agent's `images` skill (exact dimensions, format
# converts, byte budgets) runs the same scripts as the browser pyodide path.
# git + tsc: the `commit` and `debug-tsc` skills assume them.
# numpy/pandas/matplotlib via pip (wheels, no texlive): parity with the
# browser's vendored data stack so agents can assume them in both runtimes.
RUN apt-get update && apt-get install -y --no-install-recommends python3-pil git python3-pip && apt-get clean && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb
RUN pip install --break-system-packages --no-cache-dir numpy pandas matplotlib
RUN npm install -g --no-audit --no-fund typescript && npm cache clean --force
COPY dist-server/ ./dist-server/
ENV CELL_WORKSPACE=/workspace CELL_PORT=8787
EXPOSE 8787
CMD ["node", "dist-server/server/server.js"]
